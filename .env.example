TELEGRAM_BOT_TOKEN=your_token_here
ALLRATESTODAY_API_KEY=

# Runtime settings (restart bot after changes)
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=30
HTTP_USER_AGENT=PriceTrackerLearning/0.1
SCRAPER_MAX_REQUESTS=6
SCRAPER_DEFAULT_URL=https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html
ALLRATESTODAY_BASE_URL=https://allratestoday.com
BOT_MAX_URL_LENGTH=2048
BOT_TITLE_MAX_LENGTH=500
BOT_STOCK_MAX_LENGTH=300
BOT_BOOTSTRAP_RETRIES=0
LOG_LEVEL=WARNING
HTTPX_LOG_LEVEL=WARNING

# AllRatesToday error messages
RATE_ERROR_INVALID_CODE="Mã tiền phải có 3 chữ cái, ví dụ USD hoặc VND."
RATE_ERROR_AUTH="API key tỷ giá không hợp lệ hoặc không có quyền truy cập."
RATE_ERROR_QUOTA="Đã hết hạn mức API tỷ giá. Hãy kiểm tra tài khoản AllRatesToday."
RATE_ERROR_PAIR="API không chấp nhận cặp tiền này. Hãy kiểm tra mã tiền."
RATE_ERROR_REDIRECT="API tỷ giá chuyển hướng ngoài dự kiến."
RATE_ERROR_TIMEOUT="API tỷ giá phản hồi quá lâu. Hãy thử lại sau."
RATE_ERROR_NETWORK="Không kết nối được API tỷ giá. Hãy thử lại sau."
RATE_ERROR_JSON="API tỷ giá trả dữ liệu không hợp lệ."
RATE_ERROR_SYMBOLS="Không đọc được danh sách tiền tệ từ API."
RATE_ERROR_MISSING_KEY="Chưa cấu hình ALLRATESTODAY_API_KEY cho bot."
RATE_ERROR_UNSUPPORTED_CODE="Mã tiền chưa được hỗ trợ. Ví dụ: USD, VND, EUR, JPY."
RATE_ERROR_SAME_CURRENCY="Hãy chọn hai đồng tiền khác nhau; cùng đồng tiền thì tỷ lệ luôn là 1."
RATE_ERROR_INVALID_RATE="API trả tỷ giá hoặc thời điểm không hợp lệ cho cặp tiền này."

# Telegram replies: use \n for line breaks; preserve {placeholders}
BOT_MSG_HELP="Gửi một link sách Books to Scrape hoặc /add <url>.\nVí dụ: {default_url}\n/rate USD VND — xem tỷ giá 1 USD sang VND.\n/help — xem hướng dẫn.\nBot trả tên, giá và tình trạng sách. Chưa lưu theo dõi lâu dài."
BOT_MSG_INVALID_URL="Hãy gửi đúng một URL, không kèm nội dung khác."
BOT_MSG_UNSUPPORTED_SITE="Hiện chỉ hỗ trợ https://books.toscrape.com/."
BOT_MSG_LOADING_BOOK="Đang lấy thông tin sách, bạn chờ một chút nhé."
BOT_MSG_BOOK_TIMEOUT="Trang phản hồi quá lâu. Bạn thử lại sau nhé."
BOT_MSG_BOOK_NETWORK="Không tải được trang sách. Hãy kiểm tra link hoặc thử lại sau."
BOT_MSG_BOOK_INVALID="Không đọc được thông tin sách. Hãy gửi link trang chi tiết một cuốn sách; trang danh sách không được hỗ trợ."
BOT_MSG_BOOK_RESULT="Tên sách: {title}\nGiá: {price} {currency}\nTình trạng: {availability}\nThời điểm kiểm tra (UTC): {checked_at}\nLink: {url}\n\nĐây là kết quả kiểm tra hiện tại, chưa lưu theo dõi giá."
BOT_MSG_RATE_USAGE="Cú pháp: /rate USD VND — tra tỷ giá của 1 đơn vị tiền nguồn."
BOT_MSG_RATE_RESULT="1 {source} = {rate} {target}\nThời điểm dữ liệu: {observed_at}\nNguồn: AllRatesToday — tỷ giá tham khảo mid-market."
BOT_MSG_ADD_USAGE="Cú pháp: /add <url>"
BOT_MSG_UNSUPPORTED_MESSAGE="Hãy gửi URL bằng tin nhắn văn bản. Gõ /help để xem hướng dẫn."
BOT_MSG_UNKNOWN_COMMAND="Lệnh chưa được hỗ trợ. Gõ /help để xem hướng dẫn."

# Scraper validation errors; preserve {price_text}
SCRAPER_ERROR_URL="Chi ho tro URL https://books.toscrape.com/."
SCRAPER_ERROR_PRICE="Gia khong hop le: {price_text}"
SCRAPER_ERROR_DETAIL="Khong tim thay chi tiet san pham. Hay cung cap link mot cuon sach."
SCRAPER_ERROR_MISSING_FIELDS="San pham thieu ten, gia hoac tinh trang hang."
SCRAPER_ERROR_EMPTY_FIELDS="Ten hoac tinh trang hang bi rong."
SCRAPER_ERROR_REDIRECTS="Qua nhieu chuyen huong URL."

# IANA timezone for rate display
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
